# NIDARS Environment Configuration Template
# Copy this file to .env and provide your specific credentials.
# NEVER commit the real .env file or real credentials to version control.

# Application Environment (development / production / testing)
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-cryptographically-secure-random-string

# MySQL Database Configuration
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nidars_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# Geospatial Routing & OpenStreetMap Services
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
ROUTE_PROFILE=driving
ROUTE_STATION_RADIUS_KM=50.0
ROUTE_SAMPLE_INTERVAL_KM=1.0
ROUTE_RISK_PENALTY_FACTOR=10.0
ROUTE_MIN_CONFIDENCE_COVERAGE=30.0
OSRM_TIMEOUT_SECONDS=10.0

# Emergency Facility Discovery
EMERGENCY_SEARCH_RADIUS_KM=15.0
EMERGENCY_MAX_RESULTS=25
OVERPASS_TIMEOUT_SECONDS=12.0

# Phase 9: Real-Time Weather Monitoring
# Open-Meteo works without API key by default; provide WEATHER_API_KEY if using commercial providers
WEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=8.0

